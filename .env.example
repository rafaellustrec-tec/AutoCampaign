APP_URL=http://localhost:3000
DATABASE_URL=postgresql://agency:change-me@localhost:5432/agency
# Remote Supabase installation uses its own schema to preserve existing tables.
# DB_SCHEMA=autocampaign
# Optional per-process limit. Defaults to 2 on Vercel, 12 elsewhere.
# DB_POOL_MAX=2
# Generate each secret independently. Never use the example strings in production.
ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=
# Facebook Login for Business configuration with an expiring system-user token.
META_LOGIN_CONFIG_ID=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=agency-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# External publication intentionally disabled until integration certification.
ADS_PUBLISH_ENABLED=false
# Independent spending gate. Keep false throughout the paused pilot.
ADS_ACTIVATION_ENABLED=false
# native for Docker/local; vercel for Vercel Workflows.
JOB_EXECUTOR=native
# Random secret with at least 32 characters, server-only, for Vercel Cron.
CRON_SECRET=
